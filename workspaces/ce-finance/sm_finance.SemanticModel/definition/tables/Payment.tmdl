table Payment
	lineageTag: 3581a407-db5e-5808-a23d-d8d579172b56
	sourceLineageTag: [dbo].[gold_fact_payment]

	/// Number of installments (deduplicated).
	measure Payments = COUNTROWS(Payment)
		formatString: #,0
		lineageTag: d75ddd6c-3099-5dea-88b4-c167bd445d00

	/// Share of installments paid on or before the due date.
	measure 'On-time Payment Rate' = DIVIDE(CALCULATE(COUNTROWS(Payment), Payment[status] = "OnTime"), [Payments])
		formatString: 0.0%
		lineageTag: 7cad81ca-c0e9-54c4-a836-1e4ad6dba30e

	/// Average days late for late payments.
	measure 'Avg Days Late' = AVERAGEX(FILTER(Payment, Payment[days_late] > 0), Payment[days_late])
		formatString: 0.0
		lineageTag: 53d276f6-9a5d-5bac-8fe0-5ad29d5a6292

