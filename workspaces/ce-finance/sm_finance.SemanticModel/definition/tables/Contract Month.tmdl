table 'Contract Month'
	lineageTag: f553d1d4-2711-5657-a1ea-e9365f229c38
	sourceLineageTag: [dbo].[gold_fact_contract_month]

	/// Scheduled installments (USD).
	measure 'Amount Due' = SUM('Contract Month'[amount_due])
		formatString: \$#,0
		lineageTag: 7126f658-b263-5e6a-b1a2-c6cd7bf76044

	/// Collected installments (USD).
	measure 'Amount Paid' = SUM('Contract Month'[amount_paid])
		formatString: \$#,0
		lineageTag: 8c53638a-d29d-5ec0-a443-4bedc022c048

	/// Amount paid / amount due.
	measure 'Collection Rate' = DIVIDE([Amount Paid], [Amount Due])
		formatString: 0.0%
		lineageTag: b92c89cd-cd77-5a99-bb58-3cb9bc5fc592

	/// Contracts with an installment due in the period.
	measure 'Contracts Billed' = CALCULATE(DISTINCTCOUNT('Contract Month'[contract_id]), 'Contract Month'[amount_due] > 0)
		formatString: #,0
		lineageTag: f1a78389-6a2a-52b3-b72d-e7cde7fa0d49

	/// Contracts 30+ days past due at month end.
	measure 'Delinquent Contracts' = CALCULATE(DISTINCTCOUNT('Contract Month'[contract_id]), 'Contract Month'[is_delinquent] = TRUE()) + 0
		formatString: #,0
		lineageTag: a0050782-1464-5e24-97f1-0b33c9a5270e

	/// CERTIFIED KPI. Share of billed contracts that are 30+ days past due at month end (DPD counted from the first unpaid installment of the current unpaid streak). Owner: Finance domain. Source: lh_finance.gold_fact_contract_month.
	measure 'Delinquency Rate (30+ DPD)' = DIVIDE([Delinquent Contracts], [Contracts Billed])
		formatString: 0.0%
		lineageTag: 688b811c-09e5-50c8-a28d-0573a671e090

	/// Contracts 90+ days past due at month end.
	measure '90+ DPD Contracts' = CALCULATE(DISTINCTCOUNT('Contract Month'[contract_id]), 'Contract Month'[dpd_bucket] = "90+") + 0
		formatString: #,0
		lineageTag: 7cf50efc-3d0c-5da7-9ca9-7808a4af9ea0

	/// Share of billed contracts 90+ days past due.
	measure '90+ DPD Rate' = DIVIDE([90+ DPD Contracts], [Contracts Billed])
		formatString: 0.0%
		lineageTag: 07e67287-e5c5-597a-a550-146ca650ceda

