/// A consumer financing contract (loan or lease) for a site.
entity contoso#Contract
	lineageTag: c8d221b8-ed90-5b9c-8af1-cef3f94a9481
	backingTable: fin_contracts
	keyProperty: contract_id

	/// Unique contract identifier.
	property contract_id
		dataType: string
		lineageTag: 507cf87d-abd4-50fd-86c1-a31a1c08a348

		backingConfiguration
			valueColumn: fin_contracts.contract_id

