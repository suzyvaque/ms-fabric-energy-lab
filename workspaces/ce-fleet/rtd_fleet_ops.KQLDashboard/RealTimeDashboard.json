  "queries": [
    {
      "id": "25023d46-d2ab-5841-b13e-0badd7feb795",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetDeviceStatus(20m) | summarize value = countif(online)",
      "usedVariables": []
    },
    {
      "id": "aca3d610-ccdd-544f-b64c-c2c2018d4658",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetOfflineSites(20m) | count | project value = Count",
      "usedVariables": []
    },
    {
      "id": "fccecf73-5c7f-5ab4-92ce-8e4c5aec50f3",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetDeviceStatus(20m) | where online | summarize value = countif(status == 'FAULT')",
      "usedVariables": []
    },
    {
      "id": "89be392f-44a2-58ca-8be8-7110fc1d3c22",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetOpenAlerts() | count | project value = Count",
      "usedVariables": []
    },
    {
      "id": "90e011ed-2e68-50da-acfb-873de732e8a2",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetDeviceStatus(20m) | where online and device_type == 'inverter' | summarize value = round(sum(pv_kw), 1)",
      "usedVariables": []
    },
    {
      "id": "8c5da823-2386-5495-856a-5ef00e65699d",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "silver_telemetry_dedup | where event_time between (_startTime .. _endTime) and device_type in ('inverter','meter') | summarize pv = avgif(pv_kw, device_type == 'inverter') * dcountif(device_id, device_type == 'inverter'), load = avgif(load_kw, device_type == 'meter') * dcountif(device_id, device_type == 'meter') by bin(event_time, 5m) | order by event_time asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "f6b86121-805e-5a6c-a7dd-643c315ead76",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "bronze_events | extend ingested = ingestion_time() | where ingested between (_startTime .. _endTime) | summarize events = count(), p95_arrival_s = percentile((ingested - sent_time) / 1s, 95) by bin(ingested, 1m) | order by ingested asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "a9631a18-e021-502c-81e8-281b952253be",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetOpenAlerts() | lookup kind=leftouter (dim_site | project site_id, region) on site_id | project raised_at, severity, alert_code, site_id, region, device_id, message | order by raised_at desc",
      "usedVariables": []
    },
    {
      "id": "3ab6cbe1-ce3b-5b8d-b4cc-f90eeb59f789",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetOfflineSites(20m) | project site_id, region, minutes_offline, last_seen | order by minutes_offline desc",
      "usedVariables": []
    },
    {
      "id": "54cf974b-ce93-5a10-92b7-fe995d9604fc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetBatteryAnomalies(6h) | project device_id, site_id, soc_stuck, overheating, temp_max_c, readings, last_reading",
      "usedVariables": []
    },
    {
      "id": "7a2324c9-3a60-5bfd-b08b-7fe1d5f39c46",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "695eb9e4-a09d-53a1-aff1-91c03d1ca830"
      },
      "text": "FleetDeviceStatus(20m) | where device_type == 'inverter' | lookup kind=inner dim_site on site_id | project latitude, longitude, site_id, pv_kw = coalesce(pv_kw, 0.0), status",
      "usedVariables": []
    }
  ],
