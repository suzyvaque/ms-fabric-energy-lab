  "queries": [
    {
      "id": "55ef8958-650e-5c2b-bbac-6e9741ab3a58",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_utilization | top 1 by window_start | project value = utilization_pct",
      "usedVariables": []
    },
    {
      "id": "d9dea0c4-577f-52e0-9fee-c554d7cd5eca",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_utilization | top 1 by window_start | project value = round(max_of(interactive_delay_pct, interactive_rejection_pct, background_rejection_pct), 1)",
      "usedVariables": []
    },
    {
      "id": "3caee277-1fe0-5ea2-89fd-b4edfa1c6ad8",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_utilization | top 1 by window_start | project value = round(overage_total_cu_ms / 1000.0, 1)",
      "usedVariables": []
    },
    {
      "id": "5e6c3055-c9a9-5170-a701-18242f7ca88e",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_utilization | top 1 by window_start | project value = strcat(capacity_name, ' / ', sku)",
      "usedVariables": []
    },
    {
      "id": "3e83a330-dbd8-51e2-bbe4-f542e07c3aec",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "CapacityUtilization(30d, 5m) | where window_start between (_startTime .. _endTime) | project window_start, utilization_pct, max_utilization_pct, alert_line = 70.0 | order by window_start asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "39858385-e137-5e77-8763-fa162b502504",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "CapacityUtilization(30d, 5m) | where window_start between (_startTime .. _endTime) | project window_start, interactive_delay_pct, interactive_rejection_pct, background_rejection_pct | order by window_start asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "941fe857-2659-52bb-82bf-f6825f289247",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_workload | where window_start between (_startTime .. _endTime) | summarize cu_s = round(sum(background_cu_ms + interactive_cu_ms) / 1000.0, 1) by workload | order by cu_s desc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "b3df1bd0-95ea-537a-9de8-09eb9f02d175",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_workload | where window_start between (_startTime .. _endTime) | summarize cu_s = sum(background_cu_ms + interactive_cu_ms) / 1000.0 by workload, bin(window_start, 5m) | order by window_start asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "f44831da-e150-5295-b09b-b1f25a101fe6",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "CapacityAlert70Crossings(70.0, 30d) | where window_start between (_startTime .. _endTime) | order by window_start desc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "9b7ddcf6-2028-5898-8c77-82190d5e9d72",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "3fca2669-988a-5d35-9b92-c857801271b7"
      },
      "text": "capacity_state | where event_time between (_startTime .. _endTime) | project event_time, capacity_name, data | order by event_time desc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ],
