table Activities
	lineageTag: 03c1bc25-4582-59e8-8fb6-2a7e2f04d302
	sourceLineageTag: [dbo].[cap_activities]

	/// Admin activity events (last 3 days).
	measure 'Activity Events' = COUNTROWS(Activities) + 0
		formatString: #,0
		lineageTag: 9607757e-33b3-58f8-98b0-1b18e99e7354

	/// Distinct (hashed) users.
	measure 'Active Users' = DISTINCTCOUNT(Activities[user_hash])
		formatString: #,0
		lineageTag: 133e46b0-e70b-58f6-81a7-0dc2ccb019dd

	column time_utc
