table Jobs
	lineageTag: 99c956e8-7542-502b-9aaf-2709c4616314
	sourceLineageTag: [dbo].[cap_jobs]

	/// Job instances (notebooks, pipelines, ...).
	measure 'Job Runs' = COUNTROWS(Jobs) + 0
		formatString: #,0
		lineageTag: c9a34a63-2b6e-52c8-8b94-854d33f79896

	/// Job instances with status Failed.
	measure 'Failed Jobs' = CALCULATE(COUNTROWS(Jobs), Jobs[status] = "Failed") + 0
		formatString: #,0
		lineageTag: 50db80b0-343c-5b1d-b8d5-c6a1170b1393

	/// Failed / all job instances.
	measure 'Job Failure Rate' = DIVIDE([Failed Jobs], [Job Runs])
		formatString: 0.0%
		lineageTag: 457988a3-48c7-5e53-85da-2a596bb75c89

	/// Run time of job instances.
	measure 'Job Hours' = SUM(Jobs[duration_s]) / 3600
		formatString: #,0.00
		lineageTag: b93202c1-196f-5ea7-abff-d6d120a983a5

	/// Chargeback PROXY: capacity cost split by job hours. True CU chargeback needs the Capacity Metrics app (FUAM).
	measure 'Allocated Capacity Cost (proxy)' = DIVIDE([Job Hours], CALCULATE([Job Hours], REMOVEFILTERS(Workspaces), REMOVEFILTERS(Items))) * CALCULATE([Fabric Capacity Cost], REMOVEFILTERS())
		formatString: \$#,0.00
		lineageTag: efb3585c-3ff3-5405-b932-dee3c26c6ce3

