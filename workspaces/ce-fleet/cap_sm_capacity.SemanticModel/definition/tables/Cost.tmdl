table Cost
	lineageTag: 9940eb7f-937a-5eb0-8ff5-07d692500a8b
	sourceLineageTag: [dbo].[cap_cost_daily]

	/// Azure actual cost (Cost Management) in the billing currency.
	measure 'Total Cost' = SUM(Cost[cost])
		formatString: \$#,0.00
		lineageTag: 280ce000-bf6d-51c5-bb4a-c71b7acfd79a

	/// Cost of the Fabric capacity resource (pay-as-you-go hours incl. paused time = 0).
	measure 'Fabric Capacity Cost' = CALCULATE([Total Cost], Cost[resource_type] = "microsoft.fabric/capacities")
		formatString: \$#,0.00
		lineageTag: 98c14d33-dcfb-5bd4-a393-c4c4a16e45e5

	/// Average cost per day.
	measure 'Avg Daily Cost' = AVERAGEX(VALUES(Cost[date]), [Total Cost])
		formatString: \$#,0.00
		lineageTag: 8164775f-b2ab-5957-b634-655307ac9c8a

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 1bfeb021-7864-564a-aab0-9e7052d2ed6f
		sourceLineageTag: date
		summarizeBy: none
		sourceColumn: date

	column resource_type
