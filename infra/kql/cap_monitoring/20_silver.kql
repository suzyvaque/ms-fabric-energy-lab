// ===== Silver: one row per 30-second window, plus a per-workload breakdown =====
// utilization_pct = billed CU-ms in the window / (base CU x window ms). Background CU is already smoothed over 24 h,
// interactive over 5 min (Fabric smoothing). *_threshold_pct = how far the capacity is toward each throttling stage.
// "Preview" utilization (preview workloads) is reported separately and not billed.

.create-merge table capacity_utilization (window_start: datetime, window_end: datetime, capacity_id: string,
    capacity_name: string, sku: string, base_cu: real, capacity_cu_ms: real, background_cu_ms: real, interactive_cu_ms: real,
    utilization_pct: real, preview_cu_ms: real, interactive_delay_pct: real, interactive_rejection_pct: real,
    background_rejection_pct: real, overage_total_cu_ms: real, overage_add_cu_ms: real, overage_burndown_cu_ms: real,
    billing_protection_active: bool) with (folder = "Silver", docstring = "Capacity Summary events (30 s windows)")

.create-merge table capacity_workload (window_start: datetime, capacity_name: string, workload: string,
    background_cu_ms: real, interactive_cu_ms: real, preview_cu_ms: real) with (folder = "Silver",
    docstring = "Per-workload CU-ms per 30 s window (DO/ML/Kusto/ES/lake/AS/DMS/Reflex/...)")

.create-merge table capacity_state (event_time: datetime, capacity_name: string, data: dynamic) with (folder = "Silver",
    docstring = "Capacity State events (pause/resume/throttling state changes)")

.create-or-alter function with (folder = "Silver", docstring = "Update policy: Summary events -> capacity_utilization")
CapacityUtilizationParse() {
    capacity_events_raw
    | where tostring(event.type) == "Microsoft.Fabric.Capacity.Summary"
    | extend d = event.data
    | extend window_start = todatetime(d.windowStartTime), window_end = todatetime(d.windowEndTime), base_cu = toreal(d.baseCapacityUnits)
    | extend capacity_cu_ms = base_cu * datetime_diff("millisecond", window_end, window_start)
    | extend background_cu_ms = toreal(d.utilizationBackground), interactive_cu_ms = toreal(d.utilizationInteractive)
    | project window_start, window_end, capacity_id = tostring(d.capacityId), capacity_name = tostring(d.capacityName),
        sku = tostring(d.capacitySku), base_cu, capacity_cu_ms, background_cu_ms, interactive_cu_ms,
        utilization_pct = round(100.0 * (background_cu_ms + interactive_cu_ms) / capacity_cu_ms, 2),
        preview_cu_ms = toreal(d.utilizationBackgroundPreview) + toreal(d.utilizationInteractivePreview),
        interactive_delay_pct = toreal(d.interactiveDelayThresholdPercentage),
        interactive_rejection_pct = toreal(d.interactiveRejectionThresholdPercentage),
        background_rejection_pct = toreal(d.backgroundRejectionThresholdPercentage),
        overage_total_cu_ms = toreal(d.overageTotalCapacityUnitMs), overage_add_cu_ms = toreal(d.overageAddCapacityUnitMs),
        overage_burndown_cu_ms = toreal(d.overageBurndownCapacityUnitMs),
        billing_protection_active = tobool(d.overageBillingProtectionActive)
}

.create-or-alter function with (folder = "Silver", docstring = "Update policy: Summary events -> capacity_workload")
CapacityWorkloadParse() {
    capacity_events_raw
    | where tostring(event.type) == "Microsoft.Fabric.Capacity.Summary"
    | extend d = event.data
    | mv-expand w = d.capacityUnitUtilizationBreakdown
    | project window_start = todatetime(d.windowStartTime), capacity_name = tostring(d.capacityName),
        workload = tostring(w.WorkloadKind),
        background_cu_ms = coalesce(toreal(w.Utilization.Background), 0.0),
        interactive_cu_ms = coalesce(toreal(w.Utilization.Interactive), 0.0),
        preview_cu_ms = coalesce(toreal(w.UtilizationPreview.Background), 0.0) + coalesce(toreal(w.UtilizationPreview.Interactive), 0.0)
}

.create-or-alter function with (folder = "Silver", docstring = "Update policy: State events -> capacity_state")
CapacityStateParse() {
    capacity_events_raw
    | where tostring(event.type) == "Microsoft.Fabric.Capacity.State"
    | project event_time = todatetime(event['time']), capacity_name = tostring(event.data.capacityName), data = event.data
}

.alter table capacity_utilization policy update "[{\"IsEnabled\": true, \"Source\": \"capacity_events_raw\", \"Query\": \"CapacityUtilizationParse()\", \"IsTransactional\": false}]"

.alter table capacity_workload policy update "[{\"IsEnabled\": true, \"Source\": \"capacity_events_raw\", \"Query\": \"CapacityWorkloadParse()\", \"IsTransactional\": false}]"

.alter table capacity_state policy update "[{\"IsEnabled\": true, \"Source\": \"capacity_events_raw\", \"Query\": \"CapacityStateParse()\", \"IsTransactional\": false}]"

.alter table capacity_utilization policy retention "{\"SoftDeletePeriod\": \"400.00:00:00\", \"Recoverability\": \"Disabled\"}"

.alter table capacity_workload policy retention "{\"SoftDeletePeriod\": \"400.00:00:00\", \"Recoverability\": \"Disabled\"}"
