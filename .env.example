# Copy to .env (gitignored) and fill in. Never commit real values.
# Every value listed under "PRIVATE" is also blocked from commits by tools/check_private_terms.py.

# ---------- PRIVATE: tenant / identity ----------
TENANT_ID=00000000-0000-0000-0000-000000000000
TENANT_DOMAIN=contoso.onmicrosoft.com
ADMIN_UPN=admin@contoso.onmicrosoft.com
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ---------- Azure / capacity ----------
AZURE_RESOURCE_GROUP=rg-contoso-energy-lab
AZURE_LOCATION=westeurope
FABRIC_CAPACITY_NAME=contosoenergylab
# Smallest paid SKU is enough for most steps; step 6 load tests rely on a small SKU to reproduce throttling.
FABRIC_CAPACITY_SKU=F2

# ---------- Workspaces (generic names; suffixes -dev / -prod are appended) ----------
WORKSPACE_PREFIX=ce

# ---------- Entra (created by infra/entra_setup.py) ----------
ENTRA_GROUP_ADMINS=ce-fabric-admins
ENTRA_GROUP_ENGINEERS=ce-fabric-engineers
ENTRA_GROUP_VIEWERS=ce-fabric-viewers
# Security group that scopes the "service principals can use Fabric APIs" tenant settings.
ENTRA_GROUP_AUTOMATION=ce-fabric-automation
SP_APP_NAME=sp-contoso-energy-cicd
# Filled in by entra_setup.py output:
SP_CLIENT_ID=
SP_OBJECT_ID=

# ---------- GitHub ----------
GITHUB_OWNER=your-github-user
GITHUB_REPO=ms-fabric-energy-lab
# Fine-grained PAT, this repo only, Contents: read/write. Used once to create the Fabric GitHub connection.
GITHUB_FABRIC_PAT=
FABRIC_GIT_CONNECTION_NAME=gh-contoso-energy-lab

# ---------- PRIVATE: streaming endpoints (step 1b) ----------
# Event Hubs uses Entra ID (SAS disabled), so only the namespace name is needed (written by infra/eventhubs.py).
EVENTHUB_NAMESPACE=
# Only if your namespace allows SAS (not used by the lab scripts):
EVENTHUB_CONNECTION_STRING=
# Eventstream custom endpoint key (written by infra/rti_lab.py)
ESTREAM_CONNECTION_STRING=
# Production fleet eventstream es_fleet (written by infra/fleet_medallion.py eventstream)
ESTREAM_FLEET_CONNECTION_STRING=

# Step 10 A1: test Viewer identity (infra/test_identity.py). Password is generated into .env; never commit it.
TEST_USER_UPN=
TEST_USER_OBJECT_ID=
TEST_USER_PASSWORD=
# Optional alert routing (steps 6-7)
ALERT_EMAIL_DATAENG=
ALERT_EMAIL_BI=
# Steps 10/12: isolated capacity for observability tests (infra/capacity.py --target obs)
FABRIC_OBS_CAPACITY_NAME=
FABRIC_OBS_CAPACITY_SKU=F64
